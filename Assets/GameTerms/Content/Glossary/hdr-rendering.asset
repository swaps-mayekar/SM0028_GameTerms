  m_Name: hdr-rendering
  m_EditorClassIdentifier: GameTerms.Runtime::GameTerms.GlossaryTermAsset
  data:
    Id: hdr-rendering
    Term: HDR Rendering
    Abbreviation: 
    Category: 2
    Difficulty: 2
    ShortDefinition: Rendering with color values beyond the 0-1 display range, then
      tone-mapping to screen output.
    SimpleExplanation: Working with brighter-than-screen light values, then compressing
      them for the display.
    WhyItMatters: HDR enables bloom, realistic lighting contrast, and better exposure
      control.
    Example: Sunlit exteriors and dark interiors shared in one scene with exposure
      adaptation.
    CommonMistake: Enabling HDR without tone mapping, producing clipped or washed-out
      results.
    PracticePrompt: Compare one scene in LDR and HDR with identical lighting intensity.
    GameUses:
    - Cinematic lighting
    - Day-night systems
    - High-end platforms
    RelatedTermIds:
    - post-processing
    - pbr
    - render-pipeline
    Tags:
    - lighting
    - color
    - pipeline
    Synonyms: []
    CodeExample: 
    HasDiagram: 0
    DiagramType: 0
