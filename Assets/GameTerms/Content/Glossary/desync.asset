  m_Script: {fileID: 11500000, guid: 2692b90636fdb426b9c8f7cd22cafe0f, type: 3}
  m_Name: desync
  m_EditorClassIdentifier: GameTerms.Runtime::GameTerms.GlossaryTermAsset
  data:
    Id: desync
    Term: Desync
    Abbreviation: 
    Category: 5
    Difficulty: 2
    ShortDefinition: When simulated game states diverge across machines that should
      match.
    SimpleExplanation: Players or systems no longer agree on what is true in the
      match.
    WhyItMatters: Desyncs break multiplayer integrity and are hard to debug without
      determinism.
    Example: One client sees a door closed while another sees it open.
    CommonMistake: Ignoring non-deterministic APIs like unordered iteration or unsafe
      random calls.
    PracticePrompt: Add a checksum of critical state each tick and log the first
      mismatch.
    GameUses:
    - Deterministic netcode
    - Lockstep games
    - QA tools
    RelatedTermIds:
    - rollback
    - client-prediction
    - serialization
    Tags:
    - sync
    - bugs
    - netcode
    Synonyms: []
    CodeExample: 
    HasDiagram: 0
    DiagramType: 0
