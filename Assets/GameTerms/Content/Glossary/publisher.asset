  m_Name: publisher
  m_EditorClassIdentifier: GameTerms.Runtime::GameTerms.GlossaryTermAsset
  data:
    Id: publisher
    Term: Publisher
    Abbreviation: 
    Category: 9
    Difficulty: 0
    ShortDefinition: A partner that funds, markets, distributes, or certifies a game
      in exchange for commercial terms.
    SimpleExplanation: The company that helps get your game funded, marketed, and
      onto platforms.
    WhyItMatters: Publisher relationships shape milestones, creative approvals, and
      revenue shares.
    Example: A publisher funds production and handles console submission while the
      studio focuses on gameplay.
    CommonMistake: Signing terms without understanding milestone deliverables and
      kill criteria.
    PracticePrompt: List five questions you would ask a publisher about creative
      control and recoupment.
    GameUses:
    - Funding
    - Distribution
    - Marketing support
    RelatedTermIds:
    - milestone
    - soft-launch
    - intellectual-property
    Tags:
    - business
    - publishing
    - partnerships
    Synonyms: []
