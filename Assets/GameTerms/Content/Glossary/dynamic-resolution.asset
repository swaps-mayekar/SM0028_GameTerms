  m_Name: dynamic-resolution
  m_EditorClassIdentifier: GameTerms.Runtime::GameTerms.GlossaryTermAsset
  data:
    Id: dynamic-resolution
    Term: Dynamic Resolution
    Abbreviation: 
    Category: 6
    Difficulty: 2
    ShortDefinition: Scaling render resolution up or down at runtime to protect frame
      rate.
    SimpleExplanation: Drawing the game a bit blurrier when needed so it stays smooth.
    WhyItMatters: Dynamic resolution is a powerful lever for GPU-bound mobile titles.
    Example: Internal resolution drops during particle-heavy fights, then recovers
      in quieter scenes.
    CommonMistake: Scaling so far that UI or targeting readability collapses.
    PracticePrompt: Set min and max scale factors and verify readability at the lowest
      setting.
    GameUses:
    - GPU budgeting
    - Combat VFX scenes
    - Mid-tier devices
    RelatedTermIds:
    - adaptive-performance
    - overdraw
    - frame-pacing
    Tags:
    - resolution
    - gpu
    - mobile
    Synonyms: []
    CodeExample: 
    HasDiagram: 0
    DiagramType: 0
