  m_Name: unit-testing
  m_EditorClassIdentifier: GameTerms.Runtime::GameTerms.GlossaryTermAsset
  data:
    Id: unit-testing
    Term: Unit Testing
    Abbreviation: 
    Category: 7
    Difficulty: 0
    ShortDefinition: Automated tests that verify a small unit of code in isolation.
    SimpleExplanation: Tiny checks that prove one function or class behaves correctly.
    WhyItMatters: Unit tests catch logic bugs early and make refactoring safer.
    Example: A damage calculator test asserts critical hits multiply correctly.
    CommonMistake: Writing tests that depend on full scene setup and fail for unrelated
      reasons.
    PracticePrompt: Add three unit tests around one pure gameplay function and run
      them in CI.
    GameUses:
    - Combat math
    - Save serialization
    - Economy rules
    RelatedTermIds:
    - integration-testing
    - ci-cd-pipeline
    - dependency-injection
    Tags:
    - qa
    - automation
    - code
    Synonyms: []
    CodeExample: 'Assert.AreEqual(20, Damage.Apply(10, multiplier: 2f));'
    HasDiagram: 0
    DiagramType: 0
