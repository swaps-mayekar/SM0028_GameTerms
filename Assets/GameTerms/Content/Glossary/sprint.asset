  m_Name: sprint
  m_EditorClassIdentifier: GameTerms.Runtime::GameTerms.GlossaryTermAsset
  data:
    Id: sprint
    Term: Sprint
    Abbreviation: 
    Category: 9
    Difficulty: 0
    ShortDefinition: A short, time-boxed development cycle with a committed set of
      deliverables.
    SimpleExplanation: A one or two week work burst with a clear finish line.
    WhyItMatters: Sprints create predictable planning cadence and frequent integration
      points.
    Example: A two-week sprint delivers a new enemy type, related VFX, and automated
      tests.
    CommonMistake: Overcommitting sprint scope and carrying unfinished work indefinitely.
    PracticePrompt: Plan one sprint with capacity estimates and a demoable goal at
      the end.
    GameUses:
    - Agile teams
    - Milestone breakdown
    - Live ops patches
    RelatedTermIds:
    - milestone
    - bug-triage
    - ci-cd-pipeline
    Tags:
    - agile
    - planning
    - production
    Synonyms: []
