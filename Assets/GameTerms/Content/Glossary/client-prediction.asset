  m_Name: client-prediction
  m_EditorClassIdentifier: GameTerms.Runtime::GameTerms.GlossaryTermAsset
  data:
    Id: client-prediction
    Term: Client Prediction
    Abbreviation: 
    Category: 5
    Difficulty: 2
    ShortDefinition: Letting the local client simulate actions immediately before
      server confirmation.
    SimpleExplanation: Move on your screen right away even though the server has
      not confirmed yet.
    WhyItMatters: Prediction hides network delay and keeps movement feeling responsive.
    Example: A player jumps locally while waiting for the authoritative server position.
    CommonMistake: Failing to reconcile when the server rejects the predicted state.
    PracticePrompt: Implement predicted movement and log corrections when the server
      disagrees.
    GameUses:
    - Action games
    - Platformers online
    - Responsive controls
    RelatedTermIds:
    - latency
    - rollback
    - tick-rate
    - server-reconciliation
    Tags:
    - netcode
    - responsiveness
    - sync
    Synonyms: []
    CodeExample: 
    HasDiagram: 0
    DiagramType: 0
