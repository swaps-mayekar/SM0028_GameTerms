  m_Name: platform-certification
  m_EditorClassIdentifier: GameTerms.Runtime::GameTerms.GlossaryTermAsset
  data:
    Id: platform-certification
    Term: Platform Certification
    Abbreviation: 
    Category: 9
    Difficulty: 2
    ShortDefinition: Mandatory technical and compliance testing by platform holders
      before store release.
    SimpleExplanation: The official exam your build must pass to appear on a console
      or storefront.
    WhyItMatters: Certification failures can delay launches by weeks if caught late.
    Example: A console submission fails for improper suspend-resume handling and
      must be resubmitted.
    CommonMistake: Treating TRC or store checks as optional until the final week.
    PracticePrompt: Run an internal certification checklist two milestones before
      submission.
    GameUses:
    - Console publishing
    - Store submission
    - Compliance
    RelatedTermIds:
    - release-candidate
    - app-store-guidelines
    - localization-qa
    Tags:
    - certification
    - publishing
    - platforms
    Synonyms:
    - cert
    - TRC
    - lotcheck
    CodeExample: 
