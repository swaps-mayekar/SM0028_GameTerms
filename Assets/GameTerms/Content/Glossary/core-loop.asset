  m_Name: core-loop
  m_EditorClassIdentifier: GameTerms.Runtime::GameTerms.GlossaryTermAsset
  data:
    Id: core-loop
    Term: Core Loop
    Abbreviation: 
    Category: 0
    Difficulty: 0
    ShortDefinition: The repeating cycle of actions players perform most often during
      play.
    SimpleExplanation: The main thing players do again and again because it feels
      good and moves them forward.
    WhyItMatters: A clear core loop keeps sessions focused and helps teams prioritize
      features that reinforce the primary experience.
    Example: In a farming game, plant crops, wait, harvest, sell, and upgrade tools.
    GameUses:
    - Session design
    - Prototype validation
    - Feature prioritization
    RelatedTermIds:
    - game-loop
    - progression
    Tags:
    - design
    - loop
    - retention
    Synonyms:
    - primary loop
