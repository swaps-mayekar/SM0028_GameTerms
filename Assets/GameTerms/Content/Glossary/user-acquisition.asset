  m_Name: user-acquisition
  m_EditorClassIdentifier: GameTerms.Runtime::GameTerms.GlossaryTermAsset
  data:
    Id: user-acquisition
    Term: User Acquisition
    Abbreviation: ua
    Category: 8
    Difficulty: 1
    ShortDefinition: Paid or organic efforts to attract new players into the game.
    SimpleExplanation: How you find and bring in new players.
    WhyItMatters: UA efficiency determines whether growth is sustainable against
      LTV.
    Example: A creative test lowers cost per install while preserving D7 retention.
    CommonMistake: Scaling spend into channels with good installs but terrible retention.
    PracticePrompt: Compare CPI and D7 retention across two creative variants for
      one channel.
    GameUses:
    - Launch marketing
    - Live growth
    - Soft launch scaling
    RelatedTermIds:
    - ltv
    - k-factor
    - soft-launch
    - retention
    Tags:
    - growth
    - marketing
    - ua
    Synonyms:
    - UA
