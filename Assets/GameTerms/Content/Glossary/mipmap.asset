  m_Name: mipmap
  m_EditorClassIdentifier: GameTerms.Runtime::GameTerms.GlossaryTermAsset
  data:
    Id: mipmap
    Term: Mipmap
    Abbreviation: 
    Category: 2
    Difficulty: 1
    ShortDefinition: A chain of progressively smaller texture versions used when
      sampling distant surfaces.
    SimpleExplanation: Smaller copies of a texture that the GPU uses when things
      are far away.
    WhyItMatters: Mipmaps reduce aliasing and improve texture sampling performance.
    Example: A brick wall uses a lower mip level when viewed from across a courtyard.
    CommonMistake: Disabling mipmaps on world textures and introducing shimmering
      aliasing.
    PracticePrompt: Inspect mip visualization on one material and confirm distant
      surfaces use lower mips.
    GameUses:
    - Texture streaming
    - World materials
    - Mobile memory
    RelatedTermIds:
    - level-of-detail
    - texture-compression
    - texel-density
    Tags:
    - textures
    - sampling
    - optimization
    Synonyms: []
    CodeExample: 
