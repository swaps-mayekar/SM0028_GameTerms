  m_Name: z-buffer
  m_EditorClassIdentifier: GameTerms.Runtime::GameTerms.GlossaryTermAsset
  data:
    Id: z-buffer
    Term: Z Buffer
    Abbreviation: 
    Category: 2
    Difficulty: 1
    ShortDefinition: A depth buffer that stores per-pixel distance so closer surfaces
      can occlude farther ones.
    SimpleExplanation: A hidden map of how far away each pixel is from the camera.
    WhyItMatters: Depth testing is fundamental to correct sorting of opaque geometry.
    Example: A character standing in front of a wall correctly hides the wall pixels.
    CommonMistake: Fighting transparent sorting issues with z-buffer tricks that
      create artifacts.
    PracticePrompt: Render two overlapping cubes and inspect the depth buffer visualization.
    GameUses:
    - Opaque rendering
    - Sorting
    - Debug views
    RelatedTermIds:
    - overdraw
    - occlusion-culling
    - shadow-mapping
    Tags:
    - depth
    - rendering
    - gpu
    Synonyms: []
    CodeExample: 
    HasDiagram: 0
    DiagramType: 0
