  m_Script: {fileID: 11500000, guid: 2692b90636fdb426b9c8f7cd22cafe0f, type: 3}
  m_Name: object-pooling
  m_EditorClassIdentifier: GameTerms.Runtime::GameTerms.GlossaryTermAsset
  data:
    Id: object-pooling
    Term: Object Pooling
    Abbreviation: pool
    Category: 1
    Difficulty: 1
    ShortDefinition: A technique where reusable objects are created in advance and activated when needed instead of repeatedly creating and destroying them.
    SimpleExplanation: Keep a collection of reusable objects instead of constantly creating new ones.
    WhyItMatters: Pooling reduces allocation spikes and garbage collection pressure during intense gameplay.
    Example: Reuse bullet instances by disabling them after impact and returning them to a pool.
    GameUses:
    - Shooters
    - Particle effects
    - Mobile performance
    RelatedTermIds:
    - garbage-collection
    - draw-call
    Tags:
    - performance
    - memory
    - optimization
    Synonyms:
    - pooling
    - object pool
    CodeExample: GameObject obj = pool.Get();
obj.SetActive(true);
    HasDiagram: 1
    DiagramType: 1
    AddedAtUnix: 1704672000
