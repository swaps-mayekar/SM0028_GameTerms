  m_Name: app-thinning
  m_EditorClassIdentifier: GameTerms.Runtime::GameTerms.GlossaryTermAsset
  data:
    Id: app-thinning
    Term: App Thinning
    Abbreviation: 
    Category: 6
    Difficulty: 1
    ShortDefinition: Shipping only the assets and binaries a specific device needs
      to reduce install size.
    SimpleExplanation: Giving each phone just the slices of the game it actually
      requires.
    WhyItMatters: Smaller installs improve conversion and reduce uninstalls on storage-limited
      devices.
    Example: Delivering ASTC textures for capable devices and alternate formats for
      others.
    CommonMistake: Bundling every language and texture variant into one fat binary.
    PracticePrompt: Measure install size before and after enabling device-specific
      asset slicing.
    GameUses:
    - Store conversion
    - Asset delivery
    - Mobile packaging
    RelatedTermIds:
    - texture-compression
    - addressable-assets
    - app-store-guidelines
    Tags:
    - size
    - packaging
    - mobile
    Synonyms: []
