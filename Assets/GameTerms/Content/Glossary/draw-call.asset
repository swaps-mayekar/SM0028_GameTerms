  m_Name: draw-call
  m_EditorClassIdentifier: GameTerms.Runtime::GameTerms.GlossaryTermAsset
  data:
    Id: draw-call
    Term: Draw Call
    Abbreviation: 
    Category: 2
    Difficulty: 1
    ShortDefinition: A command that tells the GPU to render a batch of geometry with
      a specific material setup.
    SimpleExplanation: Each request sent to the GPU to draw something on screen.
    WhyItMatters: Too many draw calls can bottleneck rendering, especially on mobile
      GPUs.
    Example: Ten unique materials on ten objects may produce ten separate draw calls.
    GameUses:
    - Mobile optimization
    - Batching strategy
    - Profiling
    RelatedTermIds:
    - overdraw
    - level-of-detail
    - occlusion-culling
    Tags:
    - rendering
    - gpu
    - performance
    Synonyms:
    - draw
    CodeExample: 
    HasDiagram: 0
    DiagramType: 0
