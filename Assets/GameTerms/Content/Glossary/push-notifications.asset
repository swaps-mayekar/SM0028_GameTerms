  m_Name: push-notifications
  m_EditorClassIdentifier: GameTerms.Runtime::GameTerms.GlossaryTermAsset
  data:
    Id: push-notifications
    Term: Push Notifications
    Abbreviation: 
    Category: 6
    Difficulty: 1
    ShortDefinition: Remote or local messages that re-engage players when the app
      is not open.
    SimpleExplanation: Alerts that invite players back with rewards, events, or reminders.
    WhyItMatters: Well-timed notifications boost retention, but spam drives uninstalls.
    Example: A daily reward reminder arrives at the player's usual play window.
    CommonMistake: Sending frequent generic pushes with no personalization or opt-out
      clarity.
    PracticePrompt: Design three notification types with frequency caps and an opt-out
      path.
    GameUses:
    - Live ops
    - Retention campaigns
    - Event reminders
    RelatedTermIds:
    - retention
    - live-ops
    - backgrounding
    Tags:
    - retention
    - mobile
    - engagement
    Synonyms: []
    CodeExample: 
