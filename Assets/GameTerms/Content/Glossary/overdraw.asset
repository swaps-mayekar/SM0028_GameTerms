  m_Name: overdraw
  m_EditorClassIdentifier: GameTerms.Runtime::GameTerms.GlossaryTermAsset
  data:
    Id: overdraw
    Term: Overdraw
    Abbreviation: 
    Category: 2
    Difficulty: 2
    ShortDefinition: Rendering the same screen pixel multiple times due to overlapping
      transparent or layered geometry.
    SimpleExplanation: Drawing on top of the same pixel again and again.
    WhyItMatters: High overdraw can crush fill-rate performance, especially on mobile
      GPUs.
    Example: Multiple fullscreen particle layers stacking in the same view.
    GameUses:
    - VFX budgeting
    - UI transparency review
    - Mobile tuning
    RelatedTermIds:
    - draw-call
    - occlusion-culling
    Tags:
    - rendering
    - gpu
    - fill rate
    Synonyms: []
    CodeExample: 
    HasDiagram: 0
    DiagramType: 0
