  m_Script: {fileID: 11500000, guid: 2692b90636fdb426b9c8f7cd22cafe0f, type: 3}
  m_Name: safe-area
  m_EditorClassIdentifier: GameTerms.Runtime::GameTerms.GlossaryTermAsset
  data:
    Id: safe-area
    Term: Safe Area
    Abbreviation: 
    Category: 6
    Difficulty: 0
    ShortDefinition: The screen region guaranteed to be visible and interactive outside
      notches and system bars.
    SimpleExplanation: The part of the phone screen where UI will not be covered
      by cutouts or home indicators.
    WhyItMatters: Respecting safe areas prevents clipped buttons and unreadable HUD
      on modern devices.
    Example: Health bars and menus inset to avoid the notch and rounded corners.
    CommonMistake: Hardcoding offsets for one phone model and breaking layouts on
      others.
    PracticePrompt: Place a pause button using safe-area insets and verify on notch
      and non-notch layouts.
    GameUses:
    - Mobile UI
    - HUD layout
    - Platform compliance
    RelatedTermIds:
    - touch-input
    - app-store-guidelines
    - onboarding
    Tags:
    - ui
    - mobile
    - layout
    Synonyms: []
    CodeExample: 
    HasDiagram: 0
    DiagramType: 0
