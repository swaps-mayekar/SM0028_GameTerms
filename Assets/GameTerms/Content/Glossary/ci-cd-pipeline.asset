  m_Name: ci-cd-pipeline
  m_EditorClassIdentifier: GameTerms.Runtime::GameTerms.GlossaryTermAsset
  data:
    Id: ci-cd-pipeline
    Term: CI/CD Pipeline
    Abbreviation: cicd
    Category: 7
    Difficulty: 1
    ShortDefinition: Automated continuous integration and delivery that builds, tests,
      and packages changes.
    SimpleExplanation: A robot that builds your game and runs checks every time code
      lands.
    WhyItMatters: Pipelines shorten feedback loops and reduce human error in release
      packaging.
    Example: Every merge triggers unit tests, a player build, and artifact upload.
    CommonMistake: Allowing red pipelines to linger so broken main becomes normal.
    PracticePrompt: Add one failing-gate test to CI and confirm merges are blocked
      until it passes.
    GameUses:
    - Team velocity
    - Release automation
    - Quality gates
    RelatedTermIds:
    - unit-testing
    - build-verification
    - regression-testing
    Tags:
    - ci
    - automation
    - devops
    Synonyms:
    - continuous integration
    - continuous delivery
