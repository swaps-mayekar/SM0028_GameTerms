  m_Name: post-processing
  m_EditorClassIdentifier: GameTerms.Runtime::GameTerms.GlossaryTermAsset
  data:
    Id: post-processing
    Term: Post Processing
    Abbreviation: 
    Category: 2
    Difficulty: 1
    ShortDefinition: Full-screen image effects applied after the main scene is rendered.
    SimpleExplanation: Filters and polish layered on top of the finished picture.
    WhyItMatters: Post effects sell mood and readability, but can dominate GPU fill
      cost.
    Example: Bloom, color grading, and mild chromatic aberration on a cinematic shot.
    CommonMistake: Stacking multiple expensive effects that barely change the intended
      look.
    PracticePrompt: Enable only two post effects and A/B the scene for mood versus
      cost.
    GameUses:
    - Cinematics
    - Gameplay readability
    - Style direction
    RelatedTermIds:
    - hdr-rendering
    - overdraw
    - render-pipeline
    Tags:
    - effects
    - camera
    - polish
    Synonyms: []
    CodeExample: 
    HasDiagram: 0
    DiagramType: 0
