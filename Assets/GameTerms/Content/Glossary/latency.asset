  m_Name: latency
  m_EditorClassIdentifier: GameTerms.Runtime::GameTerms.GlossaryTermAsset
  data:
    Id: latency
    Term: Latency
    Abbreviation: 
    Category: 5
    Difficulty: 0
    ShortDefinition: The delay between sending an action and seeing its result across
      a network.
    SimpleExplanation: How long it takes for your input to reach the game and come
      back.
    WhyItMatters: High latency makes controls feel sluggish and can break competitive
      fairness.
    Example: A player fires on an enemy that has already moved on the server.
    CommonMistake: Blaming only ping while ignoring jitter and packet loss.
    PracticePrompt: Log round-trip time during a session and note gameplay moments
      that feel delayed.
    GameUses:
    - Netcode tuning
    - Competitive modes
    - Input responsiveness
    RelatedTermIds:
    - tick-rate
    - client-prediction
    - rollback
    - jitter
    Tags:
    - networking
    - ping
    - responsiveness
    Synonyms: []
    CodeExample: 
