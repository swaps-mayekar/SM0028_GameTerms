  m_Script: {fileID: 11500000, guid: 2692b90636fdb426b9c8f7cd22cafe0f, type: 3}
  m_Name: level-of-detail
  m_EditorClassIdentifier: GameTerms.Runtime::GameTerms.GlossaryTermAsset
  data:
    Id: level-of-detail
    Term: Level of Detail
    Abbreviation: lod
    Category: 2
    Difficulty: 1
    ShortDefinition: Using simpler versions of assets at greater distances to save
      rendering cost.
    SimpleExplanation: Show a detailed model up close and a cheaper one far away.
    WhyItMatters: LOD preserves visual quality near the player while protecting frame
      rate.
    Example: A hero mesh swaps to a lower polygon version beyond 30 meters.
    GameUses:
    - Open worlds
    - Crowd scenes
    - Mobile rendering
    RelatedTermIds:
    - draw-call
    - texture-compression
    Tags:
    - lod
    - optimization
    - meshes
    Synonyms:
    - lod
    CodeExample: 
    HasDiagram: 1
    DiagramType: 4
    AddedAtUnix: 1705190400
