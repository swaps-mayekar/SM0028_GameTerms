  m_Name: rollback
  m_EditorClassIdentifier: GameTerms.Runtime::GameTerms.GlossaryTermAsset
  data:
    Id: rollback
    Term: Rollback
    Abbreviation: ggpo
    Category: 5
    Difficulty: 2
    ShortDefinition: Rewinding and replaying simulation frames when late network
      inputs arrive.
    SimpleExplanation: Undo a few frames and replay them with the correct inputs
      once they arrive.
    WhyItMatters: Rollback enables responsive fighting and action games over real-world
      networks.
    Example: A fighting game corrects a hit after the remote input finally reaches
      the host.
    GameUses:
    - Fighting games
    - Fast action multiplayer
    - Peer-to-peer sessions
    RelatedTermIds:
    - client-prediction
    - latency
    Tags:
    - netcode
    - sync
    - fighting
    Synonyms:
    - rollback netcode
    CodeExample: 
    HasDiagram: 0
    DiagramType: 0
