  m_Name: voice-over
  m_EditorClassIdentifier: GameTerms.Runtime::GameTerms.GlossaryTermAsset
  data:
    Id: voice-over
    Term: Voice Over
    Abbreviation: vo
    Category: 4
    Difficulty: 0
    ShortDefinition: Recorded spoken performance used for characters, narration,
      or system prompts.
    SimpleExplanation: Actors speaking lines that play in the game.
    WhyItMatters: Voice over carries story, personality, and critical instructions.
    Example: A companion character warns the player about an ambush mid-mission.
    CommonMistake: Shipping dialogue without localization or subtitle fallbacks.
    PracticePrompt: Write and record three system VO lines with matching subtitle
      timing.
    GameUses:
    - Narrative games
    - Tutorials
    - Live events
    RelatedTermIds:
    - audio-ducking
    - localization
    - loudness-normalization
    Tags:
    - dialogue
    - narrative
    - performance
    Synonyms:
    - VO
    CodeExample: 
    HasDiagram: 0
    DiagramType: 0
