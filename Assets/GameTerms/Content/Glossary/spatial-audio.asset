  m_Name: spatial-audio
  m_EditorClassIdentifier: GameTerms.Runtime::GameTerms.GlossaryTermAsset
  data:
    Id: spatial-audio
    Term: Spatial Audio
    Abbreviation: 
    Category: 4
    Difficulty: 1
    ShortDefinition: Positioning sound in 3D space so players can locate sources
      by ear.
    SimpleExplanation: Hearing where a sound is coming from around you.
    WhyItMatters: Spatial audio supports stealth, awareness, and immersion.
    Example: Footsteps approaching from the left warn the player before an enemy
      appears.
    CommonMistake: Using stereo-only clips for critical directional cues.
    PracticePrompt: Place three emitters around the player and verify left, right,
      and rear localization.
    GameUses:
    - Stealth games
    - VR
    - Open worlds
    RelatedTermIds:
    - diegetic-audio
    - reverb
    - audio-mixing
    Tags:
    - 3d
    - localization
    - immersion
    Synonyms: []
    CodeExample: 
