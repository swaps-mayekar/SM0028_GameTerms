  m_Name: dedicated-server
  m_EditorClassIdentifier: GameTerms.Runtime::GameTerms.GlossaryTermAsset
  data:
    Id: dedicated-server
    Term: Dedicated Server
    Abbreviation: 
    Category: 5
    Difficulty: 1
    ShortDefinition: A persistent authoritative host that runs independently of any
      player's device.
    SimpleExplanation: A always-on game server that is not tied to one player's phone
      or console.
    WhyItMatters: Dedicated servers improve stability, anti-cheat, and session continuity.
    Example: A battle-royale match runs on cloud servers even if the creator disconnects.
    CommonMistake: Using listen servers for competitive modes that need stronger
      authority.
    PracticePrompt: Compare cheat risk and disconnect handling for listen versus
      dedicated hosting.
    GameUses:
    - Competitive games
    - Live services
    - MMO worlds
    RelatedTermIds:
    - authoritative-server
    - tick-rate
    - matchmaking
    Tags:
    - server
    - hosting
    - authority
    Synonyms: []
    CodeExample: 
    HasDiagram: 0
    DiagramType: 0
