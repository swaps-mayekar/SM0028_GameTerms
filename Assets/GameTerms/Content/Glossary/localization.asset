  m_Name: localization
  m_EditorClassIdentifier: GameTerms.Runtime::GameTerms.GlossaryTermAsset
  data:
    Id: localization
    Term: Localization
    Abbreviation: l10n
    Category: 9
    Difficulty: 1
    ShortDefinition: Adapting text, audio, imagery, and cultural details for specific
      languages and regions.
    SimpleExplanation: Preparing the game so players in other countries can understand
      and enjoy it.
    WhyItMatters: Localization expands market reach and is often required for platform
      deals.
    Example: UI, subtitles, and voice lines are adapted for five launch languages.
    CommonMistake: Leaving localization until certification week with no string freeze.
    PracticePrompt: Create a localization schedule with string freeze, translation,
      and LQA gates.
    GameUses:
    - Global launches
    - Console SKUs
    - Narrative games
    RelatedTermIds:
    - localization-qa
    - voice-over
    - platform-certification
    Tags:
    - loc
    - publishing
    - content
    Synonyms:
    - L10n
    CodeExample: 
